# Run package scripts through cmd.exe instead of Git Bash on Windows.
# With Git Bash as the script shell, Ctrl+C on `npm run dev` only stops npm; the bash -> sh -> node
# chain below it survives and keeps ports 3000/4000 busy ("Port 3000 is in use", EADDRINUSE).
# With cmd.exe the whole tree stops. Verified with a real Ctrl+C: 0 processes left, ports freed.
# Only affects npm runs started from this folder; the scripts here use no bash-only syntax.
script-shell=C:\Windows\System32\cmd.exe
