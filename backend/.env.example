DATABASE_URL="postgresql://user:password@host:5432/obbel?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
# Public base URL used in Product image URLs, e.g. https://api.example.com
PUBLIC_API_URL="http://localhost:4000"

# Cloudflare R2 (S3-compatible) — used for company logo, product image, booth
# QRIS, and shift attendance photo uploads instead of local disk.
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET="obbel-r2-storage"
# Public base URL for the bucket, e.g. the r2.dev URL or a custom domain
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
