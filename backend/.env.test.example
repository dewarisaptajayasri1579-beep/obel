# Copy to .env.test. E2E tests (test/jest-e2e.setup.ts) load it and must run against an
# isolated local database, never against obbel-db on Coolify (production).
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/obbel_test?schema=public"
JWT_SECRET="any-local-test-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
PUBLIC_API_URL="http://localhost:4000"
