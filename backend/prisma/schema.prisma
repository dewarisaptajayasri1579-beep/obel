datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BOOTH_STAFF
  ADMIN
  OWNER

  @@map("user_role")
}

enum BoothStatus {
  ACTIVE
  INACTIVE

  @@map("booth_status")
}

enum ShiftStatus {
  SCHEDULED
  OPEN
  CLOSING
  CLOSED
  CANCELLED

  @@map("shift_status")
}

enum SaleStatus {
  PENDING
  PAID
  VOIDED

  @@map("sale_status")
}

enum PaymentMethod {
  CASH
  QRIS

  @@map("payment_method")
}

enum StockMovementType {
  OPENING
  WAREHOUSE_TO_BOOTH
  SALE
  RESTOCK
  RETURN_TO_WAREHOUSE
  ADJUSTMENT
  VOID_REVERSAL

  @@map("stock_movement_type")
}

model Booth {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String
  locationName String?     @map("location_name")
  status       BoothStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  profiles      Profile[]
  shiftSessions ShiftSession[]
  boothStocks   BoothStock[]
  sales         Sale[]

  @@map("booths")
}

model Profile {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  role           UserRole
  defaultBoothId String?   @map("default_booth_id")
  defaultBooth   Booth?    @relation(fields: [defaultBoothId], references: [id])
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shiftSessions ShiftSession[]
  sales         Sale[]

  @@map("profiles")
}

model ProductCategory {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  products Product[]

  @@map("product_categories")
}

model Product {
  id         String   @id @default(uuid())
  sku        String   @unique
  name       String
  categoryId String?  @map("category_id")
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  sellPrice  BigInt   @map("sell_price")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  boothStocks    BoothStock[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model ShiftTemplate {
  id        String  @id @default(uuid())
  name      String
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  active    Boolean @default(true)

  shiftSessions ShiftSession[]

  @@map("shift_templates")
}

model ShiftSession {
  id               String      @id @default(uuid())
  businessDate     DateTime    @map("business_date") @db.Date
  boothId          String      @map("booth_id")
  booth            Booth       @relation(fields: [boothId], references: [id])
  shiftTemplateId  String      @map("shift_template_id")
  shiftTemplate    ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  staffId          String      @map("staff_id")
  staff            Profile     @relation(fields: [staffId], references: [id])
  status           ShiftStatus @default(SCHEDULED)
  scheduledStartAt DateTime    @map("scheduled_start_at")
  scheduledEndAt   DateTime    @map("scheduled_end_at")
  openedAt         DateTime?   @map("opened_at")
  closingStartedAt DateTime?   @map("closing_started_at")
  closedAt         DateTime?   @map("closed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  sales Sale[]

  @@map("shift_sessions")
}

model BoothStock {
  boothId   String   @map("booth_id")
  booth     Booth    @relation(fields: [boothId], references: [id])
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  qtyOnHand Int      @default(0) @map("qty_on_hand")
  version   BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([boothId, productId])
  @@map("booth_stocks")
}

model Sale {
  id                 String        @id @default(uuid())
  saleNo             String        @unique @map("sale_no")
  idempotencyKey     String        @unique @map("idempotency_key")
  boothId            String        @map("booth_id")
  booth              Booth         @relation(fields: [boothId], references: [id])
  shiftSessionId     String        @map("shift_session_id")
  shiftSession       ShiftSession  @relation(fields: [shiftSessionId], references: [id])
  staffId            String        @map("staff_id")
  staff              Profile       @relation(fields: [staffId], references: [id])
  status             SaleStatus    @default(PENDING)
  subtotal           BigInt
  discount           BigInt        @default(0)
  total              BigInt
  paymentMethod      PaymentMethod @map("payment_method")
  paidAt             DateTime?     @map("paid_at")
  voidedAt           DateTime?     @map("voided_at")
  voidReason         String?       @map("void_reason")
  // Lineage fields per docs/24-data-consistency-correction-reversal.md (DC-003/DC-005).
  // Correction/reversal endpoints are a later phase; columns exist now so Sale rows
  // are forward-compatible without a breaking migration later.
  transactionGroupId String        @default(uuid()) @map("transaction_group_id")
  versionNo          Int           @default(1) @map("version_no")
  createdAt          DateTime      @default(now()) @map("created_at")

  items    SaleItem[]
  payments Payment[]

  @@map("sales")
}

model SaleItem {
  id                  String  @id @default(uuid())
  saleId              String  @map("sale_id")
  sale                Sale    @relation(fields: [saleId], references: [id])
  productId           String  @map("product_id")
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String  @map("product_name_snapshot")
  unitPrice           BigInt  @map("unit_price")
  qty                 Int
  lineTotal           BigInt  @map("line_total")

  @@map("sale_items")
}

model Payment {
  id     String        @id @default(uuid())
  saleId String        @map("sale_id")
  sale   Sale          @relation(fields: [saleId], references: [id])
  method PaymentMethod
  amount BigInt
  paidAt DateTime      @default(now()) @map("paid_at")

  @@map("payments")
}

model StockMovement {
  id             String            @id @default(uuid())
  movementNo     String            @unique @map("movement_no")
  movementType   StockMovementType @map("movement_type")
  productId      String            @map("product_id")
  product        Product           @relation(fields: [productId], references: [id])
  qty            Int
  fromBoothId    String?           @map("from_booth_id")
  toBoothId      String?           @map("to_booth_id")
  referenceType  String            @map("reference_type")
  referenceId    String            @map("reference_id")
  shiftSessionId String?           @map("shift_session_id")
  businessDate   DateTime          @map("business_date") @db.Date
  occurredAt     DateTime          @default(now()) @map("occurred_at")
  createdBy      String            @map("created_by")
  note           String?

  @@map("stock_movements")
}
