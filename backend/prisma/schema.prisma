datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BOOTH_STAFF
  ADMIN
  OWNER

  @@map("user_role")
}

enum BoothStatus {
  ACTIVE
  INACTIVE

  @@map("booth_status")
}

enum ShiftStatus {
  SCHEDULED
  OPEN
  CLOSING
  CLOSED
  CANCELLED

  @@map("shift_status")
}

enum SaleStatus {
  PENDING
  PAID
  VOIDED

  @@map("sale_status")
}

enum PaymentMethod {
  CASH
  QRIS

  @@map("payment_method")
}

enum StockMovementType {
  OPENING
  WAREHOUSE_TO_BOOTH
  SALE
  RESTOCK
  RETURN_TO_WAREHOUSE
  ADJUSTMENT
  VOID_REVERSAL

  @@map("stock_movement_type")
}

enum DistributionStatus {
  DRAFT
  SENT
  RECEIVED
  DISCREPANCY
  CANCELLED

  @@map("distribution_status")
}

enum RestockRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED

  @@map("restock_request_status")
}

enum StockCountStatus {
  DRAFT
  CONFIRMED

  @@map("stock_count_status")
}

enum ReturnStatus {
  SUBMITTED
  RECEIVED
  DISCREPANCY
  CANCELLED

  @@map("return_status")
}

model Booth {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String
  locationName String?     @map("location_name")
  status       BoothStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  profiles      Profile[]
  shiftSessions ShiftSession[]
  boothStocks   BoothStock[]
  sales           Sale[]
  distributions   StockDistribution[]
  restockRequests RestockRequest[]
  stockReturns    StockReturn[]
  stockThresholds BoothStockThreshold[]

  @@map("booths")
}

model Profile {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  role           UserRole
  defaultBoothId String?   @map("default_booth_id")
  defaultBooth   Booth?    @relation(fields: [defaultBoothId], references: [id])
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shiftSessions        ShiftSession[]
  sales                Sale[]
  createdDistributions StockDistribution[] @relation("DistributionCreatedBy")
  receivedDistributions StockDistribution[] @relation("DistributionReceivedBy")
  requestedRestocks    RestockRequest[]    @relation("RestockRequestedBy")
  approvedRestocks     RestockRequest[]    @relation("RestockApprovedBy")
  countedStockCounts   ShiftStockCount[]
  submittedReturns     StockReturn[]       @relation("ReturnSubmittedBy")
  receivedReturns      StockReturn[]       @relation("ReturnReceivedBy")

  @@index([role])
  @@index([defaultBoothId])
  @@map("profiles")
}

model ProductCategory {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  products Product[]

  @@map("product_categories")
}

model Product {
  id         String   @id @default(uuid())
  sku        String   @unique
  name       String
  categoryId String?  @map("category_id")
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  sellPrice  BigInt   @map("sell_price")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  boothStocks        BoothStock[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  warehouseStock     WarehouseStock?
  distributionItems  StockDistributionItem[]
  restockRequestItems RestockRequestItem[]
  stockCountItems     ShiftStockCountItem[]
  stockReturnItems    StockReturnItem[]
  stockThresholds     BoothStockThreshold[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

/// Ambang stok per Booth-produk — AGENTS.md eksplisit melarang hardcode
/// "minimum stok per produk per Booth". Baris yang belum diisi Admin
/// dianggap memakai default (lihat DEFAULT_MINIMUM_QTY/DEFAULT_CRITICAL_QTY
/// di booth-stock-thresholds.service.ts), bukan berarti stok selalu aman.
model BoothStockThreshold {
  boothId     String  @map("booth_id")
  booth       Booth   @relation(fields: [boothId], references: [id])
  productId   String  @map("product_id")
  product     Product @relation(fields: [productId], references: [id])
  minimumQty  Int     @default(25) @map("minimum_qty")
  criticalQty Int     @default(10) @map("critical_qty")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([boothId, productId])
  @@map("booth_stock_thresholds")
}

model ShiftTemplate {
  id        String  @id @default(uuid())
  name      String
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  active    Boolean @default(true)

  shiftSessions ShiftSession[]

  @@map("shift_templates")
}

model ShiftSession {
  id               String      @id @default(uuid())
  businessDate     DateTime    @map("business_date") @db.Date
  boothId          String      @map("booth_id")
  booth            Booth       @relation(fields: [boothId], references: [id])
  shiftTemplateId  String      @map("shift_template_id")
  shiftTemplate    ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  staffId          String      @map("staff_id")
  staff            Profile     @relation(fields: [staffId], references: [id])
  status           ShiftStatus @default(SCHEDULED)
  scheduledStartAt DateTime    @map("scheduled_start_at")
  scheduledEndAt   DateTime    @map("scheduled_end_at")
  openedAt         DateTime?   @map("opened_at")
  closingStartedAt DateTime?   @map("closing_started_at")
  closedAt         DateTime?   @map("closed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  sales      Sale[]
  stockCount ShiftStockCount?

  @@index([staffId, status])
  @@index([boothId, status])
  @@index([businessDate])
  @@map("shift_sessions")
}

model BoothStock {
  boothId   String   @map("booth_id")
  booth     Booth    @relation(fields: [boothId], references: [id])
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  qtyOnHand Int      @default(0) @map("qty_on_hand")
  version   BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([boothId, productId])
  @@index([productId])
  @@map("booth_stocks")
}

model Sale {
  id                 String        @id @default(uuid())
  saleNo             String        @unique @map("sale_no")
  idempotencyKey     String        @unique @map("idempotency_key")
  boothId            String        @map("booth_id")
  booth              Booth         @relation(fields: [boothId], references: [id])
  shiftSessionId     String        @map("shift_session_id")
  shiftSession       ShiftSession  @relation(fields: [shiftSessionId], references: [id])
  staffId            String        @map("staff_id")
  staff              Profile       @relation(fields: [staffId], references: [id])
  status             SaleStatus    @default(PENDING)
  subtotal           BigInt
  discount           BigInt        @default(0)
  total              BigInt
  paymentMethod      PaymentMethod @map("payment_method")
  paidAt             DateTime?     @map("paid_at")
  voidedAt           DateTime?     @map("voided_at")
  voidReason         String?       @map("void_reason")
  // Lineage fields per docs/24-data-consistency-correction-reversal.md (DC-003/DC-005).
  // Correction/reversal endpoints are a later phase; columns exist now so Sale rows
  // are forward-compatible without a breaking migration later.
  transactionGroupId String        @default(uuid()) @map("transaction_group_id")
  versionNo          Int           @default(1) @map("version_no")
  createdAt          DateTime      @default(now()) @map("created_at")

  items    SaleItem[]
  payments Payment[]

  @@index([boothId, createdAt])
  @@index([shiftSessionId])
  @@index([staffId])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id                  String  @id @default(uuid())
  saleId              String  @map("sale_id")
  sale                Sale    @relation(fields: [saleId], references: [id])
  productId           String  @map("product_id")
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String  @map("product_name_snapshot")
  unitPrice           BigInt  @map("unit_price")
  qty                 Int
  lineTotal           BigInt  @map("line_total")

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id     String        @id @default(uuid())
  saleId String        @map("sale_id")
  sale   Sale          @relation(fields: [saleId], references: [id])
  method PaymentMethod
  amount BigInt
  paidAt DateTime      @default(now()) @map("paid_at")

  @@index([saleId])
  @@map("payments")
}

model StockMovement {
  id             String            @id @default(uuid())
  movementNo     String            @unique @map("movement_no")
  movementType   StockMovementType @map("movement_type")
  productId      String            @map("product_id")
  product        Product           @relation(fields: [productId], references: [id])
  qty            Int
  fromBoothId    String?           @map("from_booth_id")
  toBoothId      String?           @map("to_booth_id")
  referenceType  String            @map("reference_type")
  referenceId    String            @map("reference_id")
  shiftSessionId String?           @map("shift_session_id")
  businessDate   DateTime          @map("business_date") @db.Date
  occurredAt     DateTime          @default(now()) @map("occurred_at")
  createdBy      String            @map("created_by")
  note           String?

  @@index([productId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([shiftSessionId, occurredAt])
  @@index([businessDate, movementType])
  @@map("stock_movements")
}

model WarehouseStock {
  productId   String   @id @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  qtyOnHand   Int      @default(0) @map("qty_on_hand")
  version     BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("warehouse_stocks")
}

model StockDistribution {
  id               String              @id @default(uuid())
  distributionNo   String              @unique @map("distribution_no")
  boothId          String              @map("booth_id")
  booth            Booth               @relation(fields: [boothId], references: [id])
  status           DistributionStatus  @default(SENT)
  idempotencyKey   String              @unique @map("idempotency_key")
  sentAt           DateTime?           @map("sent_at")
  receivedAt       DateTime?           @map("received_at")
  createdById      String              @map("created_by")
  createdBy        Profile             @relation("DistributionCreatedBy", fields: [createdById], references: [id])
  receivedById     String?             @map("received_by")
  receivedBy       Profile?            @relation("DistributionReceivedBy", fields: [receivedById], references: [id])
  note             String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  items          StockDistributionItem[]
  restockRequest RestockRequest?

  @@index([boothId, status])
  @@index([status])
  @@map("stock_distributions")
}

model StockDistributionItem {
  id             String            @id @default(uuid())
  distributionId String            @map("distribution_id")
  distribution   StockDistribution @relation(fields: [distributionId], references: [id])
  productId      String            @map("product_id")
  product        Product           @relation(fields: [productId], references: [id])
  qtySent        Int               @map("qty_sent")
  qtyReceived    Int?              @map("qty_received")

  @@unique([distributionId, productId])
  @@index([productId])
  @@map("stock_distribution_items")
}

model RestockRequest {
  id             String               @id @default(uuid())
  requestNo      String               @unique @map("request_no")
  boothId        String               @map("booth_id")
  booth          Booth                @relation(fields: [boothId], references: [id])
  status         RestockRequestStatus @default(REQUESTED)
  requestedById  String               @map("requested_by")
  requestedBy    Profile              @relation("RestockRequestedBy", fields: [requestedById], references: [id])
  approvedById   String?              @map("approved_by")
  approvedBy     Profile?             @relation("RestockApprovedBy", fields: [approvedById], references: [id])
  distributionId String?              @unique @map("distribution_id")
  distribution   StockDistribution?   @relation(fields: [distributionId], references: [id])
  rejectReason   String?              @map("reject_reason")
  note           String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  items RestockRequestItem[]

  @@index([boothId, status])
  @@index([status])
  @@map("restock_requests")
}

model RestockRequestItem {
  id               String         @id @default(uuid())
  restockRequestId String         @map("restock_request_id")
  restockRequest   RestockRequest @relation(fields: [restockRequestId], references: [id])
  productId        String         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id])
  qtyRequested     Int            @map("qty_requested")

  @@unique([restockRequestId, productId])
  @@index([productId])
  @@map("restock_request_items")
}

model ShiftStockCount {
  id             String            @id @default(uuid())
  shiftSessionId String            @unique @map("shift_session_id")
  shiftSession   ShiftSession      @relation(fields: [shiftSessionId], references: [id])
  status         StockCountStatus  @default(DRAFT)
  countedById    String            @map("counted_by")
  countedBy      Profile           @relation(fields: [countedById], references: [id])
  countedAt      DateTime          @default(now()) @map("counted_at")
  confirmedAt    DateTime?         @map("confirmed_at")
  note           String?

  items ShiftStockCountItem[]

  @@map("shift_stock_counts")
}

model ShiftStockCountItem {
  id             String          @id @default(uuid())
  stockCountId   String          @map("stock_count_id")
  stockCount     ShiftStockCount @relation(fields: [stockCountId], references: [id])
  productId      String          @map("product_id")
  product        Product         @relation(fields: [productId], references: [id])
  expectedQty    Int             @map("expected_qty")
  actualQty      Int             @map("actual_qty")
  discrepancyQty Int             @default(0) @map("discrepancy_qty")
  reasonCode     String?         @map("reason_code")
  reasonNote     String?         @map("reason_note")

  @@unique([stockCountId, productId])
  @@index([productId])
  @@map("shift_stock_count_items")
}

model StockReturn {
  id             String       @id @default(uuid())
  returnNo       String       @unique @map("return_no")
  boothId        String       @map("booth_id")
  booth          Booth        @relation(fields: [boothId], references: [id])
  status         ReturnStatus @default(SUBMITTED)
  idempotencyKey String       @unique @map("idempotency_key")
  submittedById  String       @map("submitted_by")
  submittedBy    Profile      @relation("ReturnSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime     @default(now()) @map("submitted_at")
  receivedById   String?      @map("received_by")
  receivedBy     Profile?     @relation("ReturnReceivedBy", fields: [receivedById], references: [id])
  receivedAt     DateTime?    @map("received_at")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  items StockReturnItem[]

  @@index([boothId, status])
  @@index([status])
  @@map("stock_returns")
}

model StockReturnItem {
  id             String      @id @default(uuid())
  stockReturnId  String      @map("stock_return_id")
  stockReturn    StockReturn @relation(fields: [stockReturnId], references: [id])
  productId      String      @map("product_id")
  product        Product     @relation(fields: [productId], references: [id])
  qtySubmitted   Int         @map("qty_submitted")
  qtyReceived    Int?        @map("qty_received")

  @@unique([stockReturnId, productId])
  @@index([productId])
  @@map("stock_return_items")
}
